<!DOCTYPE html>
<html>
<head>
    <title>Gallery</title>
</head>
<body>
    <h1>Gallery</h1>
    <ul>
        <% images.forEach(image => { %>
            <li>
                <img src="/<%= image.path %>" alt="<%= image.name %>" width="200">
                <p><%= image.name %></p>
            </li>
        <% }); %>
    </ul>
</body>
</html>
